{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zombies companion map profile v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "spawn": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "starting_points": {
      "type": "integer",
      "minimum": 0
    },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "zone": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "price": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "zone",
          "price"
        ]
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "x",
          "y"
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "price": {
            "type": "integer",
            "minimum": 0
          },
          "seconds": {
            "type": "integer",
            "minimum": 1
          },
          "bidirectional": {
            "type": "boolean"
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "price",
          "seconds",
          "bidirectional"
        ]
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "absent": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "takes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "gives": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "cost": {
            "type": "integer",
            "minimum": 0
          },
          "reserve": {
            "type": "integer",
            "minimum": 0
          },
          "seconds": {
            "type": "integer",
            "minimum": 1
          },
          "cooldown_after": {
            "type": "integer",
            "minimum": 0
          },
          "needs_ready": {
            "type": "boolean"
          },
          "reserve_until": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "required": [
          "id",
          "name",
          "at",
          "cost",
          "seconds"
        ]
      }
    },
    "perk_pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flags",
        "increment",
        "other_max"
      ],
      "properties": {
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "increment": {
          "type": "integer",
          "minimum": 0
        },
        "other_max": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "version",
    "id",
    "name",
    "title",
    "release",
    "spawn",
    "starting_points",
    "flags",
    "goals",
    "zones",
    "edges",
    "actions"
  ]
}
